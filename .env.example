# Optional LLM tracking classification (docs/llm-tracking-evaluation.md). Off by default.
# Copy to .env (ignored by Git) and fill in. Never commit a real key.
TRACKING_LLM_ENABLED=false
TOGETHER_API_KEY=
# Required when enabled; e.g. Qwen/Qwen3.5-9B (price verified in src/tracking/llm/config.ts).
TRACKING_LLM_MODEL=
TRACKING_LLM_MODE=shadow
TRACKING_LLM_TIMEOUT_MS=5000
TRACKING_LLM_MAX_CALLS=20
TRACKING_LLM_MAX_COST_USD=0.02
# For a model without a verified price (USD per 1M tokens), otherwise the integration stays off:
# TRACKING_LLM_PRICE_INPUT_PER_M=
# TRACKING_LLM_PRICE_OUTPUT_PER_M=
# Default: <out>/llm-incidents.jsonl
# TRACKING_LLM_INCIDENT_LOG=
