{
  "name": "mailstep-complaint-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Mailstep case study: deterministic complaint eligibility and carrier tracking classification",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "all": "npm run typecheck && npm test && npm start",
    "example:create": "node src/cli.ts --data examples/create --out out/create --skip-eval",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 \"test/**/*.test.ts\"",
    "verify:baseline": "node scripts/verify-baseline.ts",
    "mutation": "node scripts/mutation.ts",
    "llm:eval": "node scripts/llm-eval.ts",
    "ci": "npm run typecheck && npm run test:coverage && npm run verify:baseline"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
